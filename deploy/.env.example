# Copy to /opt/store/.env on the Droplet. Never commit the real file.

# The store's domain, without www (www.example.com redirects here, see docker/Caddyfile).
# Its DNS must point at the Droplet first, see docs/deployment/digitalocean.md.
SERVER_NAME=example.com
APP_URL=https://example.com

APP_NAME="My Store"
APP_ENV=production
APP_DEBUG=false
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Generate each password with: openssl rand -hex 24
DB_DATABASE=store
DB_USERNAME=store
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# About 40% of the Droplet's memory: 768M on 2 GB, 1500M on 4 GB.
MYSQL_BUFFER_POOL=768M

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# The redis service in compose.yaml. Generate with: openssl rand -hex 24
REDIS_PASSWORD=
# REDIS_MAXMEMORY=256mb
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Error reports with the stack trace, by e-mail, from https://sentry.io (free plan).
# Customer details are not sent (send_default_pii is off).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# "cloudflare" when the domain is proxied by Cloudflare (orange cloud), so rate
# limits see the visitor and not Cloudflare. Leave empty when not proxied.
TRUSTED_PROXIES=

# Required: account verification emails are sent through this server.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="My Store"

# International format. Only needed to replace the default in config/store.php.
# STORE_WHATSAPP=
STORE_REQUIRE_STAFF_2FA=true

# Unconfirmed WhatsApp orders are cancelled after this many hours and their stock returned (0 = never).
STORE_PENDING_ORDER_HOURS=48
STORE_ORDERS_PER_PHONE_PER_DAY=3
STORE_COUPON_FAILURES_PER_HOUR=8
# Set to true only while testing a new third-party script; violations are then logged, not blocked.
STORE_CSP_REPORT_ONLY=false
# Cloudflare Turnstile (free) on checkout: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-side rendering by the ssr service in compose.yaml. Pages still work if it stops.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# Online payment. Empty: checkout through WhatsApp only. Set to the gateway key
# once its adapter exists (docs/architecture/payments.md). "fake" is refused here.
PAYMENT_GATEWAY=
# Unpaid online orders are released (stock returned) after this many minutes.
PAYMENT_PENDING_MINUTES=30

# Staff alerts to a Telegram group (optional): create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Staff are signed out after this many idle minutes (0 = session lifetime).
STORE_STAFF_IDLE_MINUTES=60
