# Copy to /opt/store/backup.env on the Droplet (chmod 600). Never commit the real file.
# Used by backup.sh to keep an encrypted copy of every backup off the server.

# A DigitalOcean Spaces bucket (or any S3-compatible storage) in another region.
# Create it, then an access key limited to that bucket.
RESTIC_REPOSITORY=s3:https://fra1.digitaloceanspaces.com/your-backup-bucket/store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encrypts everything before it leaves the server. Generate with: openssl rand -base64 33
# Keep a copy somewhere safe outside the server (a password manager): without it
# the backups cannot be read by anyone, including you.
RESTIC_PASSWORD=
